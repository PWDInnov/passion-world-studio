rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /applications/{applicationId}/cv.pdf {
      allow create: if request.resource.contentType == 'application/pdf'
        && request.resource.size > 0
        && request.resource.size <= 5242880;
      allow read, delete: if request.auth != null;
    }
  }
}
